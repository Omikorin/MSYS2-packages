pkgname='lcov'
epoch=1
pkgver=2.5
pkgrel=1
pkgdesc="Front-end for GCC's coverage testing tool gcov"
arch=('any')
url='https://github.com/linux-test-project/lcov'
msys2_repository_url='https://github.com/linux-test-project/lcov'
msys2_references=(
  'archlinux: lcov'
)
license=('spdx:GPL-2.0-or-later')
backup=(
  'etc/lcovrc'
)
depends=(
  'perl'
  'perl-Capture-Tiny'
  # 'perl-DateTime'
  # 'perl-Devel-Cover'
  'perl-JSON'
  # 'perl-Memory-Process'
  'perl-PerlIO-gzip'
)
makedepends=(
  # 'python-sphinx'
  # 'python-sphinx_rtd_theme'
)
optdepends=(
  # unavailable
  # 'perl-GD: render frames in html output'
  # 'perl-JSON-XS: faster JSON parsing than built in JSON:PP'
  'python: enable extra support scripts'
  # 'python-coverage: enable python coverage reporting'
  # 'python-xlsxwriter: generate spreadsheet reports'
)
source=("https://github.com/linux-test-project/${pkgname}/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('7e5e5a154bd5f3557659c328cab376764e7abd238bb403c424472c296b175126')

package() {
  cd "${pkgname}-${pkgver}"

  # no_doc unavailable in 2.5
  make PREFIX=/usr CFG_DIR=/etc DESTDIR="${pkgdir}" LCOV_NO_DOC=1 install
}
